# STK (sc3-plugins' copy, a git submodule), once for each of its two plug-ins; without it, no StkUGens
set(STKDIR "${CONCHA_SC3_DIR}/external_libraries/stk")
if(NOT EXISTS "${STKDIR}/include/Stk.h")
    message(STATUS "sc3-plugins' STK sources not found (${STKDIR}): StkUGens and StkInst left out")
else()
file(GLOB concha_stk "${STKDIR}/src/*.cpp")
file(GLOB concha_stk_unneeded "${STKDIR}/src/Rt*.cpp" "${STKDIR}/src/Inet*.cpp" "${STKDIR}/src/Socket.cpp"
    "${STKDIR}/src/Tcp*.cpp" "${STKDIR}/src/UdpSocket.cpp" "${STKDIR}/src/Thread.cpp" "${STKDIR}/src/Mutex.cpp"
    "${STKDIR}/src/Messager.cpp")
list(REMOVE_ITEM concha_stk ${concha_stk_unneeded})
list(SORT concha_stk)
set(concha_stk_includes "${STKDIR}" "${STKDIR}/include" "${STKDIR}/src/include")
# its wave tables: compiled in, written to Concha's cache by concha_stk_extract_rawwaves (src/sc/StkRawwaves)
set(concha_stk_defines __LITTLE_ENDIAN__ "RAWWAVE_PATH=::concha_stk_rawwave_path()")
set(concha_stk_pre "#include \"sc/StkRawwaves.h\"\n")
concha_sc3_unit(StkUGens SOURCES "${SC3P}/StkUGens/StkAll.cpp" ${concha_stk} INCLUDES ${concha_stk_includes}
    DEFINES ${concha_stk_defines} PRE "${concha_stk_pre}")
concha_sc3_unit(StkInst SOURCES "${SC3P}/StkInst/StkInst.cpp" ${concha_stk} INCLUDES ${concha_stk_includes}
    DEFINES ${concha_stk_defines} PRE "${concha_stk_pre}")
file(GLOB concha_rawwaves "${STKDIR}/rawwaves/*.raw")
list(SORT concha_rawwaves)
set(text "// generated by cmake/Sc3Plugins.cmake from STK's rawwaves\n#include <string_view>\n#include <utility>\n#include <vector>\nnamespace {\n")
set(list "")
set(k 0)
foreach(f ${concha_rawwaves})
    get_filename_component(name "${f}" NAME)
    file(READ "${f}" hex HEX)
    string(REGEX REPLACE "(..)" "'\\\\x\\1'," hex "${hex}")
    string(APPEND text "const char kWave${k}[] = {${hex}};\n")
    string(APPEND list "        {\"${name}\", {kWave${k}, sizeof(kWave${k})}},\n")
    math(EXPR k "${k} + 1")
endforeach()
string(APPEND text "} // namespace\nconst std::vector<std::pair<std::string_view, std::string_view>>& concha_stk_rawwaves()\n{\n    static const std::vector<std::pair<std::string_view, std::string_view>> waves = {\n${list}    };\n    return waves;\n}\n")
if(EXISTS "${CONCHA_SC3_GEN}/StkRawwaves.cpp")
    file(READ "${CONCHA_SC3_GEN}/StkRawwaves.cpp" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL text)
    file(WRITE "${CONCHA_SC3_GEN}/StkRawwaves.cpp" "${text}")
endif()
target_sources(concha_sc_ugens PRIVATE "${CONCHA_SC3_GEN}/StkRawwaves.cpp" "${PROJECT_SOURCE_DIR}/src/sc/StkRawwaves.cpp")
target_compile_definitions(concha_sc_ugens PUBLIC CONCHA_SC3_STK) # SC_HostDriver extracts the waves
endif()

