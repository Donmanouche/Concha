# Every sc3-plugins UGen compiled into the embedded scsynth (included by cmake/ScSynth.cmake, after
# concha_sc_ugens, which already has the families StrudelDirt's SynthDefs use).
#
# sc3-plugins builds each source (or small group of sources) as its own shared library, so their
# names never meet: many define the same classes and helpers (Faust's dsp / UI / mydsp in every
# Faust plug-in), and several share a PluginLoad name (Chaos, TagSystem, Filter...). Here each
# unit's sources are wrapped in a namespace of their own (concha_sc3_<unit>), after
# src/sc/Sc3Prelude.h has included, at global scope, the headers they take from outside: their
# PluginLoad(Name) becomes concha_sc3_<unit>::Name_Load, a Faust unit's load() concha_sc3_<unit>::load. A generated Sc3Loads.cpp calls them all
# (concha_sc3_load_all, from SC_HostDriver's loadExtraUGens).
#
# Left out: LadspaUGen (loads the system's LADSPA libraries), NovaDiskIO (supernova only), and the
# sources concha_sc_ugens already has.

set(CONCHA_SC3_GEN "${PROJECT_BINARY_DIR}/sc3")

# A copy of sc3-plugins' sources where extern "C" is extern "C++": C names ignore namespaces, and
# many sources share some (Faust_Ctor, server_type, A2B_Ctor...). Rewritten only when they change.
set(CONCHA_SC3_SRC "${CONCHA_SC3_GEN}/src")
file(GLOB_RECURSE concha_sc3_all RELATIVE "${SC3P}" "${SC3P}/*.cpp" "${SC3P}/*.c" "${SC3P}/*.h" "${SC3P}/*.hpp" "${SC3P}/*.hh")
foreach(f ${concha_sc3_all})
    if(f MATCHES "^(LadspaUGen|NovaDiskIO|local)/")
        continue()
    endif()
    file(READ "${SC3P}/${f}" body)
    string(REGEX REPLACE "extern[ \t]*\"C\"" "extern \"C++\"" body "${body}")
    set(out "${CONCHA_SC3_SRC}/${f}")
    if(EXISTS "${out}")
        file(READ "${out}" old)
        if(old STREQUAL body)
            continue()
        endif()
    endif()
    file(WRITE "${out}" "${body}")
endforeach()
set(concha_sc3_objects "")
set(concha_sc3_decls "")
set(concha_sc3_calls "")

# concha_sc3_unit(<unit> SOURCES <files...> [FAUST] [INCLUDES <dirs...>] [DEFINES <defs...>]
#                 [PRE <text>] [POST <text>])
# PRE goes before the namespace, POST inside it after the source; @UNIT@ is the namespace.
function(concha_sc3_unit unit)
    cmake_parse_arguments(U "FAUST" "PRE;POST" "SOURCES;INCLUDES;DEFINES" ${ARGN})
    string(REPLACE "@UNIT@" "concha_sc3_${unit}" U_PRE "${U_PRE}")
    string(REPLACE "@UNIT@" "concha_sc3_${unit}" U_POST "${U_POST}")
    string(REPLACE "${SC3P}/" "${CONCHA_SC3_SRC}/" U_INCLUDES "${U_INCLUDES}") # the copies' headers
    set(wrapped "")
    set(first TRUE)
    foreach(src ${U_SOURCES})
        string(REPLACE "${SC3P}/" "${CONCHA_SC3_SRC}/" src "${src}")
        get_filename_component(base "${src}" NAME_WE)
        get_filename_component(ext "${src}" EXT)
        set(out "${CONCHA_SC3_GEN}/${unit}/${base}${ext}")
        set(text "// generated by cmake/Sc3Plugins.cmake\n#include \"sc/Sc3Prelude.h\"\n#define CONCHA_SC3_UNIT concha_sc3_${unit}\n")
        set(post "")
        if(first)
            set(post "${U_POST}") # once per unit
        endif()
        set(first FALSE)
        string(APPEND text "${U_PRE}namespace concha_sc3_${unit} {\n#include \"${src}\"\n${post}} // namespace concha_sc3_${unit}\n")
        if(EXISTS "${out}")
            file(READ "${out}" old)
        else()
            set(old "")
        endif()
        if(NOT old STREQUAL text)
            file(WRITE "${out}" "${text}")
        endif()
        list(APPEND wrapped "${out}")
        # the entry points, for Sc3Loads.cpp
        file(READ "${src}" body)
        if(U_FAUST) # its load(), now in the namespace
            set(decl "namespace concha_sc3_${unit} { void load(InterfaceTable*); }\n")
            set(call "    concha_sc3_${unit}::load(table);\n")
            string(FIND "${concha_sc3_decls}" "${decl}" seen)
            if(seen EQUAL -1)
                set(concha_sc3_decls "${concha_sc3_decls}${decl}" PARENT_SCOPE)
                set(concha_sc3_decls "${concha_sc3_decls}${decl}")
                set(concha_sc3_calls "${concha_sc3_calls}${call}" PARENT_SCOPE)
                set(concha_sc3_calls "${concha_sc3_calls}${call}")
            endif()
        else()
            string(REGEX MATCHALL "\nPluginLoad\\([A-Za-z0-9_]+\\)" loads "\n${body}")
            foreach(l ${loads})
                string(REGEX REPLACE "\nPluginLoad\\(([A-Za-z0-9_]+)\\)" "\\1" name "${l}")
                set(decl "namespace concha_sc3_${unit} { void ${name}_Load(InterfaceTable*); }\n")
                set(call "    concha_sc3_${unit}::${name}_Load(table);\n")
                set(concha_sc3_decls "${concha_sc3_decls}${decl}")
                set(concha_sc3_calls "${concha_sc3_calls}${call}")
            endforeach()
            set(concha_sc3_decls "${concha_sc3_decls}" PARENT_SCOPE)
            set(concha_sc3_calls "${concha_sc3_calls}" PARENT_SCOPE)
        endif()
    endforeach()
    add_library(concha_sc3_${unit} OBJECT ${wrapped})
    set_target_properties(concha_sc3_${unit} PROPERTIES CXX_STANDARD 17 CXX_VISIBILITY_PRESET hidden
        C_VISIBILITY_PRESET hidden POSITION_INDEPENDENT_CODE ON)
    target_compile_definitions(concha_sc3_${unit} PRIVATE STATIC_PLUGINS SC_MEMORY_ALIGNMENT=32 NOVA_SIMD SC_FFT_GREEN
        NDEBUG ${U_DEFINES})
    if(U_FAUST)
        target_compile_definitions(concha_sc3_${unit} PRIVATE "SC_FAUST_PREFIX=\"\"")
    endif()
    target_include_directories(concha_sc3_${unit} PRIVATE "${PROJECT_SOURCE_DIR}/src" ${U_INCLUDES}
        $<TARGET_PROPERTY:concha_sc_ugens,INCLUDE_DIRECTORIES> "${CONCHA_SC3_SRC}")
    target_compile_options(concha_sc3_${unit} PRIVATE -w -fno-finite-math-only)
    set(concha_sc3_objects ${concha_sc3_objects} $<TARGET_OBJECTS:concha_sc3_${unit}> PARENT_SCOPE)
endfunction()

# one unit per source, as sc3-plugins' FIND_AND_BUILD_PLUGINS
function(concha_sc3_each dir)
    cmake_parse_arguments(E "" "PRE;POST" "EXCEPT;INCLUDES" ${ARGN})
    file(GLOB sources "${SC3P}/${dir}/*.cpp")
    list(SORT sources)
    foreach(src ${sources})
        get_filename_component(base "${src}" NAME_WE)
        if(base IN_LIST E_EXCEPT)
            continue()
        endif()
        concha_sc3_unit(${base} SOURCES "${src}" INCLUDES "${SC3P}/${dir}" ${E_INCLUDES} PRE "${E_PRE}" POST "${E_POST}")
    endforeach()
    set(concha_sc3_objects ${concha_sc3_objects} PARENT_SCOPE)
    set(concha_sc3_decls "${concha_sc3_decls}" PARENT_SCOPE)
    set(concha_sc3_calls "${concha_sc3_calls}" PARENT_SCOPE)
endfunction()

